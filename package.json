{
  "name": "wrytr",
  "version": "0.1.0",
  "private": false,
  "description": "A local-first, browser-based Typst editor for iPad and desktop.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/wrytr.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@myriaddreamin/typst-ts-renderer": "^0.6.1-rc5",
    "@myriaddreamin/typst-ts-web-compiler": "^0.6.1-rc5",
    "@myriaddreamin/typst.ts": "^0.6.1-rc5",
    "@replit/codemirror-vim": "^6.3.0",
    "idb": "^8.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.8.3",
    "vite": "^7.1.10",
    "vite-plugin-pwa": "^1.1.0"
  }
