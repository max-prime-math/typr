{
  "name": "typr",
  "version": "0.1.0",
  "private": false,
  "description": "A local-first, browser-based Typst editor for iPad and desktop.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/max-prime-math/typr.git"
  },
  "scripts": {
    "predev": "npm run icons:check && npm run busytex:assets && npm run tikz-editor:assets && npm run tylax:assets",
    "dev": "vite",
    "prebuild": "npm run icons:check && npm run busytex:assets && npm run tikz-editor:assets && npm run tylax:assets",
    "build": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && vite build && node scripts/prepare-external-asset-build.mjs",
    "build:self-hosted": "npm run icons:check && npm run tikz-editor:assets && npm run tylax:assets && tsc --noEmit && tsc -p tsconfig.node.json --noEmit && TYPR_BUILD_TARGET=self-hosted vite build && TYPR_BUILD_TARGET=self-hosted node scripts/prepare-external-asset-build.mjs && node scripts/audit-self-hosted-build.mjs",
    "build:development": "TYPR_DEPLOYMENT_CHANNEL=development npm run build",
    "build:beta": "TYPR_DEPLOYMENT_CHANNEL=beta npm run build",
    "build:stable": "TYPR_DEPLOYMENT_CHANNEL=stable npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "busytex:assets": "node scripts/ensure-busytex-assets.cjs",
    "tikz-editor:assets": "node scripts/ensure-tikz-editor-assets.cjs",
    "tylax:assets": "node scripts/ensure-tylax-assets.cjs",
    "icons:check": "node scripts/verify-icon-assets.mjs",
    "compiler-assets:verify": "node scripts/prepare-compiler-assets.mjs",
    "compiler-assets:verify-public": "node scripts/verify-compiler-assets.mjs",
    "test:docker:self-hosted": "node scripts/test-typr-docker.mjs",
    "test:e2e:diagram": "playwright test --config=playwright.config.ts",
    "test:e2e:pwa": "npm run build && playwright test --config=playwright.pwa.config.ts",
    "test:e2e:texpresso": "playwright test --config=playwright.texpresso.config.ts",
    "test:e2e:self-hosted": "node scripts/test-typr-self-hosted-e2e.mjs",
    "screenshots:readme": "node scripts/capture-readme-screenshots.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@max-prime-math/typr-companion-protocol": "https://github.com/max-prime-math/typr-server/archive/44d0b7d4e773209c21ddba7b15e64a5f236e7c7a.tar.gz",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0-rc2",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0-rc2",
    "@myriaddreamin/typst.ts": "^0.7.0-rc2",
    "@replit/codemirror-vim": "^6.3.0",
    "codemirror-lang-latex": "^0.4.1",
    "fflate": "^0.8.3",
    "harper.js": "^2.4.0",
    "idb": "^8.0.3",
    "jspdf": "^4.0.0",
    "just-bash": "^2.14.5",
    "marked": "^18.0.0",
    "mitex-wasm": "^0.2.5",
    "pdfjs-dist": "^6.0.227",
    "ratex-wasm": "^0.1.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "svg2pdf.js": "^2.7.0",
    "svgedit": "^7.4.1",
    "texlyre-busytex": "1.1.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@playwright/test": "1.49.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "tar": "7.5.22",
    "typescript": "^5.8.3",
    "vite": "^7.1.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7"
  }
}
